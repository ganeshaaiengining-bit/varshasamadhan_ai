# Dependencies and build output
node_modules/
.next/
out/

# Secrets — never commit these. `.env` holds the Gemini key, the Supabase
# database password and the admin password. `.env.example` is the safe template
# and IS committed.
.env
.env.local
.env*.local

# SQLite was the original database. It is replaced by Postgres, but the file is
# kept locally as a backup of anything edited locally after the last seed.
prisma/dev.db
prisma/dev.db-journal
prisma/dev.db-wal
prisma/dev.db-shm

# The data export produced by `npm run db:export`, pending `npm run db:import`.
.import/

# Logs
*.log

# TypeScript's incremental build cache. Regenerated by `npm run typecheck`,
# and merging it between branches causes spurious "file not found" errors.
*.tsbuildinfo

# Generated art and verification output — all reproducible with `npm run art`
# and `npm run verify`, and large enough to slow every clone down.
preview/
shots/

# OS noise
.DS_Store
Thumbs.db
desktop.ini