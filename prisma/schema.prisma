// ---------------------------------------------------------------------------
// वर्षा समाधान AI — database
//
// Postgres, on Supabase's free tier. Deliberately free, and deliberately not
// self-hosted: this has to keep working for a stranger who opens the link a
// year from now, on a machine nobody maintains.
//
// ── Why it changed from SQLite ─────────────────────────────────────────────
// SQLite was right while the site ran on one machine, and it is what the seed
// scripts were written against. It cannot survive deployment: Vercel, Netlify
// and Cloudflare Pages all run as serverless functions with a read-only, reset
// on every deploy filesystem. A SQLite *file* there means every visitor sees an
// empty site and every deploy silently discards the reviews.
//
// Supabase's free tier is 500 MB with no credit card, which is roughly fifty
// times what this site will ever use — the entire dataset is under 100 KB.
//
// ── Why there is no `directUrl` ────────────────────────────────────────────
// `DATABASE_URL` points at Supabase's pooler (port 5432), which is the only
// thing that works from serverless. A migration needs a direct connection, and
// Prisma takes that from `DIRECT_URL`. Both are the same database; only the
// port and the pooler differ.
//
// ── Staying on SQLite ──────────────────────────────────────────────────────
// Nothing above forbids it. Set `provider = "sqlite"`, point `DATABASE_URL` at
// `file:./dev.db`, and the whole app runs locally with no server at all. The
// only code that cares about the difference is the import script in
// `prisma/import-postgres.ts`.
//
// Design rules:
//  1. Every piece of guidance text lives in `articles` so the owner can add or
//     correct it from the admin panel. Nothing is hard-coded in a component.
//  2. Safety-critical content (emergency numbers, medical advice) is flagged, so
//     the UI can insist on showing the helpline alongside it.
//  3. `asked_questions` is written by the visitor and read only by the owner. It
//     stores the question text, never an identity.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"

  // The pooler. `connection_limit=1` is not a typo — a serverless function is
  // scaled horizontally, so every concurrent request is a separate client, and
  // Supabase's free tier allows only a small number of direct connections.
  // One each, shared through the pooler, is what keeps the database from
  // refusing connections under a traffic spike.
  url = env("DATABASE_URL")

  // A direct connection, used only by `prisma migrate`. Never at runtime.
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  subtitle    String   @default("")
  icon        String   @default("help") // key into the shared icon set
  accent      String   @default("saffron") // saffron | teal | indigo | rose | leaf
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Article {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  slug        String   @unique
  title       String
  summary     String   @default("")
  // Plain paragraphs separated by a blank line. Stored as text rather than HTML
  // so the owner cannot inject a script tag through the admin panel.
  body        String
  // A short line the voice can read before the full answer. Long text is
  // exhausting to listen to, especially on a small phone speaker.
  voiceSummary String  @default("") @map("voice_summary")
  isEmergency Boolean  @default(false)
  isMedical    Boolean  @default(false)
  // Shown in a red box the visitor cannot miss.
  helpline    String   @default("")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, isPublished, sortOrder])
  @@map("articles")
}

// ---------------------------------------------------------------------------
// REVIEWS
//
// A visitor leaves a star rating and a written comment. No account, no name
// required — the service asks for no personal information at all, and a login
// wall in front of a free help service would defeat its purpose.
//
// `isApproved` exists because the site is open to anyone. Unmoderated comments
// on a page about bereavement attract abuse; the owner reviews a queue rather
// than publishing immediately.
//
// `reply` is the owner's written response. Nothing here can be written by a
// visitor, so it cannot be spoofed.
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(uuid())
  // Which page or category the review is about. '*' means the whole service.
  target     String   @default("*")
  rating     Int
  // Optional name. Blank is normal and allowed — plenty of elderly users will
  // not type one, and requiring it would cost real reviews.
  authorName String?  @map("author_name")
  // Where the visitor came from, shown only to the owner as a hint.
  city       String?
  comment    String
  isApproved Boolean  @default(false) @map("is_approved")
  reply      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([target, isApproved, createdAt])
  @@index([isApproved])
  @@map("reviews")
}

model AskedQuestion {
  id         String   @id @default(uuid())
  question   String
  // Which category the visitor was on, if any. Useful for "what do people keep
  // asking about" without storing who asked.
  category   String   @default("")
  // True when the AI answered, false when the visitor was shown a stored answer.
  wasAnswered Boolean  @default(false) @map("was_answered")
  // Set only when the AI is unavailable, so the owner can see demand for a
  // capability that is missing rather than a site that is simply idle.
  wasFailed  Boolean   @default(false) @map("was_failed")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("asked_questions")
}