// ---------------------------------------------------------------------------
// वर्षा समाधान AI — database
//
// Postgres, on Supabase's free tier. Deliberately free, and deliberately not
// self-hosted: this has to keep working for a stranger who opens the link a
// year from now, on a machine nobody maintains.
//
// ── Why it changed from SQLite ─────────────────────────────────────────────
// SQLite was right while the site ran on one machine, and it is what the seed
// scripts were written against. It cannot survive deployment: Vercel, Netlify
// and Cloudflare Pages all run as serverless functions with a read-only, reset
// on every deploy filesystem. A SQLite *file* there means every visitor sees an
// empty site and every deploy silently discards the reviews.
//
// Supabase's free tier is 500 MB with no credit card, which is roughly fifty
// times what this site will ever use — the entire dataset is under 100 KB.
//
// ── Why there is no `directUrl` ────────────────────────────────────────────
// `DATABASE_URL` points at Supabase's pooler (port 5432), which is the only
// thing that works from serverless. A migration needs a direct connection, and
// Prisma takes that from `DIRECT_URL`. Both are the same database; only the
// port and the pooler differ.
//
// ── Staying on SQLite ──────────────────────────────────────────────────────
// Nothing above forbids it. Set `provider = "sqlite"`, point `DATABASE_URL` at
// `file:./dev.db`, and the whole app runs locally with no server at all. The
// only code that cares about the difference is the import script in
// `prisma/import-postgres.ts`.
//
// Design rules:
//  1. Every piece of guidance text lives in `articles` so the owner can add or
//     correct it from the admin panel. Nothing is hard-coded in a component.
//  2. Safety-critical content (emergency numbers, medical advice) is flagged, so
//     the UI can insist on showing the helpline alongside it.
//  3. `asked_questions` is written by the visitor and read only by the owner. It
//     stores the question text, never an identity.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // The pooler. `connection_limit=1` is not a typo — a serverless function is
  // scaled horizontally, so every concurrent request is a separate client, and
  // Supabase's free tier allows only a small number of direct connections.
  // One each, shared through the pooler, is what keeps the database from
  // refusing connections under a traffic spike.
  url = env("DATABASE_URL")

  // A direct connection, used only by `prisma migrate`. Never at runtime.
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  subtitle    String   @default("")
  icon        String   @default("help") // key into the shared icon set
  accent      String   @default("saffron") // saffron | teal | indigo | rose | leaf
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Article {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  slug        String   @unique
  title       String
  summary     String   @default("")
  // Plain paragraphs separated by a blank line. Stored as text rather than HTML
  // so the owner cannot inject a script tag through the admin panel.
  body        String
  // A short line the voice can read before the full answer. Long text is
  // exhausting to listen to, especially on a small phone speaker.
  voiceSummary String  @default("") @map("voice_summary")
  isEmergency Boolean  @default(false)
  isMedical    Boolean  @default(false)
  // Shown in a red box the visitor cannot miss.
  helpline    String   @default("")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, isPublished, sortOrder])
  @@map("articles")
}

// ---------------------------------------------------------------------------
// REVIEWS
//
// A visitor leaves a star rating and a written comment. No account, no name
// required — the service asks for no personal information at all, and a login
// wall in front of a free help service would defeat its purpose.
//
// `isApproved` exists because the site is open to anyone. Unmoderated comments
// on a page about bereavement attract abuse; the owner reviews a queue rather
// than publishing immediately.
//
// `reply` is the owner's written response. Nothing here can be written by a
// visitor, so it cannot be spoofed.
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(uuid())
  // Which page or category the review is about. '*' means the whole service.
  target     String   @default("*")
  rating     Int
  // Optional name. Blank is normal and allowed — plenty of elderly users will
  // not type one, and requiring it would cost real reviews.
  authorName String?  @map("author_name")
  // Where the visitor came from, shown only to the owner as a hint.
  city       String?
  comment    String
  isApproved Boolean  @default(false) @map("is_approved")
  reply      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([target, isApproved, createdAt])
  @@index([isApproved])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// CONTACT MESSAGES
//
// A visitor writes to the owner from /madad: an error they found, something
// this service got wrong, a place they are that is not here yet. The four
// cards on that page ask for exactly these, and until now it asked in one
// direction only — "write your experience", with nowhere to write it.
//
// Nothing here is ever public. A message does not appear on a page, does not
// become an article, and is not sent anywhere. It sits here for the owner to
// read. `isRead` exists because a list of everything ever sent is a list
// nobody reads; the point is the unread ones.
//
// `isPublished` is deliberately absent. There is no column that could be set
// to make a message visible, so "the owner will publish it" is not something
// this schema can do by accident. If a message turns out to be worth a page,
// the owner writes an article — which is a decision, made on purpose, with a
// title and a body and someone accountable for it.
// ---------------------------------------------------------------------------

model ContactMessage {
  id      String @id @default(uuid())
  // Both optional and nullable. The site collects no personal information
  // anywhere, and a contact form that required a name would contradict every
  // other page on it. Blank is normal.
  name    String? @map("name")
  city    String?
  message String
  isRead  Boolean @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

model AskedQuestion {
  id         String   @id @default(uuid())
  question   String
  // Which category the visitor was on, if any. Useful for "what do people keep
  // asking about" without storing who asked.
  category   String   @default("")
  // True when the AI answered, false when the visitor was shown a stored answer.
  wasAnswered Boolean  @default(false) @map("was_answered")
  // Set only when the AI is unavailable, so the owner can see demand for a
  // capability that is missing rather than a site that is simply idle.
  wasFailed  Boolean   @default(false) @map("was_failed")
  // Which provider produced the answer: gemini, ollama or pollinations.
  //
  // This is not only for reporting. The daily cap counts Gemini calls, and it
  // used to count every answered question because there was nothing to count
  // more precisely — so a morning answered entirely by the keyless provider
  // used up a budget that belongs to the keyed one, and Gemini was skipped for
  // the rest of the day while it still had quota. The traffic that was meant to
  // be free was spending the moneyed provider's allowance.
  provider   String   @default("")
  // Which Gemini model answered, when Gemini answered.
  //
  // This column is the whole reason the site's AI keeps working through a busy
  // day. Google's free allowance is counted per model — twenty calls each, six
  // models, none of them shared — and the site used to count every Gemini
  // answer into one number. So an allowance spent on the first four models was
  // also spent on the two that had never been called, and the whole chain was
  // switched off while most of the day's quota sat untouched.
  model      String   @default("")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([provider, createdAt])
  @@index([model, createdAt])
  @@map("asked_questions")
}

/* ==========================================================================
   OWNER LOGIN
   ========================================================================== */

/**
 * The owner's password, when the owner has set one for themselves.
 *
 * ── Why this table exists at all ─────────────────────────────────────────────
 * The password used to live only in an environment variable, which meant that
 * changing it meant redeploying the site and meant the owner had to hand the new
 * value to somebody else to put there. Neither is acceptable for the one
 * credential that guards every unpublished thing on this site.
 *
 * So the owner sets it themselves, once, through a one-time link, and from then
 * on this row is the password. The environment variable is still read, and still
 * works, as a fallback — so a fresh install with no row in this table is not
 * locked out, and so a deployment that never runs the setup link behaves exactly
 * as it did before.
 *
 * ── What is stored ──────────────────────────────────────────────────────────
 * A hash and a salt. Never the password, and never the hash without its own salt,
 * so a copy of this table is not a copy of the password.
 *
 * One row. The id is fixed rather than generated so that a second attempt to set
 * a password overwrites the first instead of quietly creating a second owner.
 */
model OwnerCredential {
  id     String @id @default("owner")
  /// A scrypt hash, hex encoded.
  hash   String
  /// The salt it was hashed with, hex encoded.
  salt   String
  /// When it was last changed, so the page can say how old the password is.
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("owner_credentials")
}

/* ==========================================================================
   VISITOR ACCOUNTS
   ========================================================================== */

/**
 * A person who came back.
 *
 * ── What an account is for here, and what it is not ───────────────────────
 *
 * Not for saving questions. The audience is elderly, often low-literacy, and
 * frequently using a shared or borrowed phone, so a password prompt in front of
 * the one thing they came to do is the single most effective way to lose them.
 * Every question works with no account at all, and always will.
 *
 * It is for two things that genuinely need continuity: keeping the language
 * they chose and the answers they saved, across visits and devices. A person
 * who has asked about their father's medicines on one phone and wants it again
 * on another is the case this exists for.
 *
 * ── Why there is no name, no email requirement, no phone ───────────────────
 *
 * Because the service's promise is that it collects nothing it does not need.
 * A phone number is a name and an address together in this country. Making it
 * optional rather than asking for it is the difference between collecting
 * contacts and not.
 *
 * A visitor picks a handle of their own; there is no "real name" field at all.
 * `handle` is unique and case-insensitive, so two people cannot be confused for
 * each other, and it is the only identifier shown anywhere.
 */
model User {
  id String @id @default(uuid())

  /**
   * The name the visitor chose. Unique, case-insensitive.
   *
   * Not an email address. An address would be the easiest identifier to assume
   * everyone has, and it is also the identifier nobody in this audience wants to
   * hand to a website that cannot tell them what it does with it.
   */
  handle String @unique

  /**
   * The person's own name, the way they would write it.
   *
   * The owner asked for this. It sits beside the handle rather than replacing
   * it: the handle is the short thing that signs in and cannot be ambiguous,
   * and this is the name a person recognises as their own.
   *
   * Optional. A shared or borrowed phone is common in the audience this service
   * is for, and somebody who does not want to give their name should still be
   * able to ask about their mother's cough. Nothing on the site requires it,
   * nothing is shown publicly, and it is never shown on the sign-in page where
   * somebody else might pick up the phone.
   */
  name String @default("")

  /**
   * A scrypt hash, never a password.
   *
   * Generated in the application rather than by the database, because the
   * database is the thing being protected and should not be handing out
   * anything about how it is protected.
   */
  passwordHash String @map("password_hash")

  /**
   * Salt, stored beside the hash rather than inside it.
   *
   * Kept separate so a partial dump of this column is not enough to attack, and
   * so the two can be compared in tests without being equal for the wrong
   * reason.
   */
  passwordSalt String @map("password_salt")

  // Optional by design. See the note above.
  phone String?

  // The language this person chose. An account exists to carry things across
  // visits, and re-choosing a language on every visit is one of the things it
  // is for.
  language String @default("hi")

  /**
   * Bumped whenever the password changes, so a session opened before the change
   * stops working rather than continuing for the rest of its life.
   */
  passwordChangedAt DateTime @default(now()) @map("password_changed_at")

  lastSeenAt DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")

  sessions   Session[]
  savedNotes SavedNote[]

  @@index([createdAt])
  @@map("users")
}

/**
 * One browser, one signed-in device.
 *
 * A table rather than a signed cookie alone, for one reason: signing someone
 * out has to actually end the session. A stateless cookie cannot be revoked, so
 * "log out" would be a request to please stop trusting it — which is not the
 * same thing, and matters most on a shared phone where the next person is not
 * the one who logged in.
 *
 * The token is stored hashed for the same reason the password is: a stolen
 * database should not hand over live sessions.
 */
model Session {
  id String @id @default(uuid())

  // sha256 of the token, not the token. See the note above.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * When this session stops being honoured even if the token is presented.
   *
   * Checked on every use rather than only at login, which is what makes a
   * changed password end existing sessions instead of only preventing new ones.
   */
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/**
 * An answer the visitor kept.
 *
 * The one thing here that makes an account worth having: a person asking about
 * a relative's medicines can save the answer and come back to it, and read it
 * aloud again later when they have forgotten what was said.
 */
model SavedNote {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The question as asked. Kept with the answer, because an answer without its
  // question is a paragraph nobody can place later.
  question String

  answer String

  // Which language it came back in, so it is read back in the same one.
  language String @default("hi")

  // Empty rather than null for "this is a general note". A note typed by hand
  // and one saved from an answer are different things and are shown differently.
  category String @default("")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("saved_notes")
}

/**
 * Pictures the owner uploads from the admin panel.
 *
 * ── Why these live in the database and not in /public ───────────────────────
 *
 * Because a file dropped into `public/` is gone at the next deployment. Every
 * deploy replaces the build output, so a photograph added that way survives
 * until somebody pushes, then vanishes with no warning and no error — which is
 * the worst way for a memorial page to break.
 *
 * Storing it here means the owner changes it from a phone, at any time, and it
 * is still there after a deploy, a rollback, or a month.
 *
 * ── Why base64 in a column and not a bytea ─────────────────────────────────
 *
 * Because it has to survive `prisma db push` on a provider that may move the
 * table, and because the only consumer is a small `<img>` tag. Base64 costs a
 * third in size and buys a value that is portable, diffable in a backup, and
 * impossible to half-write.
 *
 * The size ceiling is enforced in the route, not here. A column this wide can
 * hold a great deal more than a photograph and would happily accept it.
 */
model SiteImage {
  /// A short name: "varsha-photo". The key is the URL.
  key String @id

  /// image/jpeg, image/png, image/webp. Kept so the browser is told rather than guessed.
  mime String @default("image/jpeg")

  /// Base64, without the `data:` prefix.
  data String

  /// The size of the decoded bytes, for the panel's display and for the ceiling check.
  byteSize Int @default(0) @map("byte_size")

  /// What a screen reader should say. Not left blank: an unlabelled photograph of a person is invisible to half the people who would be reading it.
  alt String @default("")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_images")
}