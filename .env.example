# ===========================================================================
#  वर्षा समाधान AI — environment
#
#  Copy this file to `.env` and fill in what you have. Everything except
#  GEMINI_API_KEY is optional: the site runs, and every page works, without it.
# ===========================================================================

# --- Database -------------------------------------------------------------
# SQLite is a file, so there is no server, no user and no password to set up.
DATABASE_URL="file:./dev.db"

# --- AI (optional) ---------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
#
# SECURITY: this key lives on the server only. It is never sent to the browser,
# never written into a page, and never readable by a visitor. Putting a key in
# front-end code is the single most common way a free AI service gets hijacked —
# anyone can read it with Ctrl+U and spend your quota, or run up a bill in your
# name. Never move this into a component.
#
# With no key the site still works: visitors get the stored answers instead, and
# the admin panel shows that AI questions are arriving unanswered.
GEMINI_API_KEY=""

# Which model to use. Free tier, as of now:
#   gemini-3.8-flash  — best of the free models
#   gemini-3.7-flash
#   gemini-3.6-flash
GEMINI_MODEL="gemini-3.8-flash"

# Hard ceiling for AI spend per day, in requests. Once reached the site stops
# calling the API and falls back to stored answers, so a bad day or a burst of
# traffic cannot turn into a bill.
GEMINI_DAILY_REQUEST_LIMIT="40"

# Set to "false" only if you have deliberately read the Google terms about using
# submitted content to improve their products. Leave it true on the free tier
# unless that trade-off is one you have actually made.
GEMINI_CONTENT_MAY_BE_USED_FOR_TRAINING="true"

# --- Site ------------------------------------------------------------------
# Shown in the header and used in WhatsApp link previews.
NEXT_PUBLIC_SITE_NAME="वर्षा समाधान AI"
# Absolute site URL. WhatsApp needs this to build a proper preview card.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# --- Owner (optional) ------------------------------------------------------
# Used for the admin sign-in. Change both before putting this on the internet.
ADMIN_PHONE="9000000001"
ADMIN_PASSWORD="Varsha@12345"