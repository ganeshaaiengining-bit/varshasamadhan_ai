# ===========================================================================
#  वर्षा समाधान AI — environment
#
#  Copy this file to `.env` and fill in what you have. Everything except
#  GEMINI_API_KEY is optional: the site runs, and every page works, without it.
# ===========================================================================

# --- Database -------------------------------------------------------------
# Supabase (free — 500 MB, no credit card). Get both strings from
# Supabase dashboard -> your project -> Project Settings -> Database -> URI.
#
# There are TWO strings there and they are not interchangeable:
#
#   DATABASE_URL   the *pooler* one, port 5432. The app uses this.
#   DIRECT_URL     the *direct* one, port 5432 or 6543 depending on what you
#                  copied. Only `prisma migrate` uses this.
#
# On a serverless host such as Vercel the pooler is not optional: each visitor
# may get their own function instance, and the free tier allows only a handful
# of direct connections. The pooler recycles them.
#
# To run locally on SQLite instead, use this instead of the two above and set
# `provider = "sqlite"` in prisma/schema.prisma:
#   DATABASE_URL="file:./dev.db"
DATABASE_URL=""
DIRECT_URL=""

# --- AI (optional) ---------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
#
# SECURITY: this key lives on the server only. It is never sent to the browser,
# never written into a page, and never readable by a visitor. Putting a key in
# front-end code is the single most common way a free AI service gets hijacked —
# anyone can read it with Ctrl+U and spend your quota, or run up a bill in your
# name. Never move this into a component.
#
# With no key the site still works: visitors get the stored answers instead, and
# the admin panel shows that AI questions are arriving unanswered.
GEMINI_API_KEY=""

# Which model to use. Free tier, as of now:
#   gemini-3.8-flash  — best of the free models
#   gemini-3.7-flash
#   gemini-3.6-flash
GEMINI_MODEL="gemini-3.8-flash"

# Hard ceiling for AI spend per day, in requests. Once reached the site stops
# calling the API and falls back to stored answers, so a bad day or a burst of
# traffic cannot turn into a bill.
GEMINI_DAILY_REQUEST_LIMIT="40"

# Set to "false" only if you have deliberately read the Google terms about using
# submitted content to improve their products. Leave it true on the free tier
# unless that trade-off is one you have actually made.
GEMINI_CONTENT_MAY_BE_USED_FOR_TRAINING="true"

# --- Site ------------------------------------------------------------------
# Shown in the header and used in WhatsApp link previews.
NEXT_PUBLIC_SITE_NAME="वर्षा समाधान AI"
# Absolute site URL. WhatsApp needs this to build a proper preview card.
# On localhost this is http://localhost:3001; once deployed, change it to your
# real address or WhatsApp will show a preview of nothing.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# --- Owner (optional, but see below) ----------------------------------------
# Used for the admin sign-in at `/admin`.
#
# SECURITY — read this before deploying.
#
# 1. This file is committed to a public repository. A password written here is
#    public knowledge, so nothing here is a password. Put your real one in
#    `.env`, which is never committed.
#
# 2. If `ADMIN_PASSWORD` is missing or shorter than 8 characters, the admin panel
#    locks itself and says so on screen. This is deliberate. An earlier version
#    treated an empty password as "no check configured" and therefore allowed
#    everyone in — which on this site means publishing and deleting reviews and
#    reading the names and cities visitors typed in.
#
# 3. After signing in the password is exchanged for an `httpOnly` session cookie.
#    The password is not used again, so it is not re-sent on every action and
#    does not sit in browser memory for the whole session.
#
# 4. Five wrong guesses lock that address out for fifteen minutes.
#
# ADMIN_PHONE is unused by the panel; kept so an existing deployment does not
# break on upgrade.
ADMIN_PHONE="9000000001"
ADMIN_PASSWORD=""